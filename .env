# Flora - Local Development Environment Variables
# -----------------------------------------------------------------------------
# Values from: Supabase Dashboard -> Settings -> API
# VITE_SUPABASE_URL          = Project URL
# VITE_SUPABASE_PUBLISHABLE_KEY = "Publishable" / "anon public" key (safe to expose in browser)
# Note: the legacy name VITE_SUPABASE_ANON_KEY is also accepted by the client
# for backward compatibility, but VITE_SUPABASE_PUBLISHABLE_KEY is preferred.

VITE_SUPABASE_URL=https://nrqouxrqdudbitlnpipb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FoklysX0i7hSqjzU3UkMXQ_aqEufynk

# Used by Google OAuth redirect and password reset emails.
VITE_APP_URL=http://localhost:3000


# OPTIONAL: Client-side Gemini fallback.
# Only needed if you have NOT deployed the Supabase Edge Function.
# WARNING: Never expose a production key here — use GEMINI_API_KEY in the
# Edge Function secrets instead (see BACKEND.md, Step 5).
# VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_FOR_LOCAL_FALLBACK_ONLY

# ── Federated ML (EfficientNetB0) ────────────────────────────
# Set to 'true' to enable the federated ML inference path alongside Gemini.
# Requires the Flask inference API to be running (python federated_ml/inference.py).
VITE_ENABLE_FEDERATED_ML=true
VITE_FEDERATED_ML_API_URL=http://localhost:5000
